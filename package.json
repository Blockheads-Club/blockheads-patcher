{
  "name": "blockheads-patcher",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app",
    "plugins/tauri-plugin-apk-tools"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter @bh-patcher/app build",
    "dev": "bun run --filter @bh-patcher/app dev",
    "test:cov": "bun run --filter '*' test:cov",
    "test:fast": "bun run --filter '*' test:fast",
    "test:cov:native": "scripts/coverage-rust.sh && scripts/coverage-kotlin.sh",
    "build:worker": "bun run --filter @bh-patcher/app build:worker"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4"
  }
}
