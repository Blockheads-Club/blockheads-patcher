{
  "branches": ["main", { "name": "dev", "prerelease": "dev" }],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/github", { "assets": [{ "path": "dist-release/*" }], "successComment": false, "failComment": false, "releasedLabels": false }]
  ]
}
