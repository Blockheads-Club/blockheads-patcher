{
  "name": "@bh-patcher/app",
  "version": "0.3.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun scripts/fetch-mod-loader.ts && vite build",
    "build:web": "bun scripts/fetch-mod-loader.ts && vite build && node scripts/finalize-web.mjs build",
    "fetch:mod-loader": "bun scripts/fetch-mod-loader.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:fast": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bh-patcher/core": "workspace:*",
    "@bh-patcher/tauri-plugin-apk-tools-api": "workspace:*",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "0.8.2",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "3.2.4"
  }
}
