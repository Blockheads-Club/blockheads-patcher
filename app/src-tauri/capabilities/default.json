{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities. File access is limited to the app cache work directory and user-picked paths (added to the scope by the dialog plugin).",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "windows",
    "macOS",
    "android"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "apk-tools:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-exists",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPCACHE/bhp"
        },
        {
          "path": "$APPCACHE/bhp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPCACHE/bhp/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPCACHE/bhp"
        },
        {
          "path": "$APPCACHE/bhp/**"
        }
      ]
    }
  ]
}
