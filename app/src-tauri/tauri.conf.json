{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockheads Patcher",
  "version": "0.2.0",
  "identifier": "com.blockheadspatcher.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blockheads Patcher",
        "width": 900,
        "height": 700,
        "minWidth": 900,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost blob: data: https://api.github.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Patch your own copy of The Blockheads for Android",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US",
          "tr-TR"
        ]
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNTJDNDA2NzdCQjdFMjQKUldRa2ZydDNCc1JTZTc3N0d4T0J3eEhFeXdTZGpwQ04ySXdwNGl2WmxFMkJYby80cC9iWUdVU20K",
      "endpoints": [
        "https://github.com/Blockheads-Club/blockheads-patcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
